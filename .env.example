# Backend (copy this file to .env for local development)
APP_NAME=Route53 Clone API
APP_ENV=development
API_V1_PREFIX=/api/v1
# Relative SQLite paths resolve from the backend working directory.
# Railway production will set: sqlite:////data/route53.db
DATABASE_URL=sqlite:///./route53.db
FRONTEND_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=24
# Public mocked-development credentials; replace them for deployed demos.
DEMO_USER_NAME=Route53 Demo User
DEMO_USER_EMAIL=demo@route53.local
DEMO_USER_PASSWORD=Route53Demo123!
LOG_LEVEL=INFO

# Frontend (exposed to the browser; never put secrets in NEXT_PUBLIC_* values)
# Must be an absolute HTTP(S) URL ending in /api/v1. Configure this in Vercel.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
